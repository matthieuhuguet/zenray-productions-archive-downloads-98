from __future__ import annotations

import json
import re
import subprocess
from pathlib import Path

from PIL import Image

ROOT = Path(__file__).resolve().parent
PARAMS = json.loads((ROOT / "_params.json").read_text())
CHROME = "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"


def materialize(template: str, values: dict[str, object]) -> str:
    content = (ROOT / template).read_text()
    for key, value in values.items():
        content = content.replace("{{" + key + "}}", str(value))
    remaining = sorted(set(re.findall(r"\{\{([^}]+)\}\}", content)))
    if remaining:
        raise SystemExit("Paramètres non résolus : " + ", ".join(remaining))
    return content


def render(source: Path, output: Path, width: int, height: int) -> None:
    subprocess.run([
        CHROME, "--headless=new", "--disable-gpu", "--hide-scrollbars",
        "--default-background-color=00000000", f"--window-size={width},{height}",
        f"--screenshot={output}", f"file://{source}?render=1",
    ], check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def build_compositions() -> None:
    canvas = PARAMS["canvas"]
    title = PARAMS["title"]
    for variant in PARAMS["variants"]:
        values = {
            **title,
            **variant,
            "canvas_width": canvas["width"],
            "canvas_height": canvas["height"],
        }
        destination = ROOT / f"{variant['id']}.html"
        destination.write_text(materialize("composition-template.html", values))
        render(destination, ROOT / variant["output"], canvas["width"], canvas["height"])


def main() -> None:
    build_compositions()
    for variant in PARAMS["variants"]:
        output = ROOT / variant["output"]
        with Image.open(output) as image:
            if image.size != (PARAMS["canvas"]["width"], PARAMS["canvas"]["height"]):
                raise SystemExit(f"Mauvaise dimension : {output}")
    full = Image.open(ROOT / PARAMS["variants"][0]["output"]).convert("RGB")
    soft = Image.open(ROOT / PARAMS["variants"][1]["output"]).convert("RGB")
    sample = (400, 800)
    opacity = float(PARAMS["variants"][1]["background_opacity"])
    expected = tuple(round(channel * opacity + 255 * (1 - opacity)) for channel in full.getpixel(sample))
    rendered = soft.getpixel(sample)
    if any(abs(a - b) > 2 for a, b in zip(expected, rendered)):
        raise SystemExit("L'opacité de la seconde image ne correspond pas au réglage")


if __name__ == "__main__":
    main()
