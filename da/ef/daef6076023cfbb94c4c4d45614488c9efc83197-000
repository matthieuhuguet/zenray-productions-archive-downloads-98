<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=1672, height=941">
  <style>
    @font-face { font-family: CompositionSerif; src: url("file:///Users/zenray/Library/Fonts/AnthropicSerif-Regular.ttf"); }
    :root { --background-opacity: 0.5; --title-x: 535px; --title-y: 465px; --title-font-size: 42px; --title-tracking: 10.8px; }
    html, body { width: 1672px; height: 941px; margin: 0; overflow: hidden; background: #fff; }
    .canvas { position: relative; width: 100%; height: 100%; overflow: hidden; }
    .background, .title { position: absolute; }
    .background { width: 100%; height: 100%; object-fit: fill; opacity: var(--background-opacity); }
    .title { left: var(--title-x); top: var(--title-y); color: #f0ede5; font-family: CompositionSerif; font-size: var(--title-font-size); font-weight: 400; letter-spacing: var(--title-tracking); line-height: 1; white-space: nowrap; text-shadow: 0 1px 2px rgba(0,0,0,.46); }
    #controls { position: fixed; top: 20px; left: 20px; z-index: 2; display: grid; gap: 8px; padding: 14px; border-radius: 12px; background: rgba(0,0,0,.74); color: white; font: 16px Inter, sans-serif; }
    #controls label { display: grid; grid-template-columns: 128px 220px 42px; gap: 8px; align-items: center; }
    #controls input { vertical-align: middle; }
    html.render #controls { display: none; }
  </style>
</head>
<body>
  <main class="canvas">
    <img class="background" src="assets/background-02.png" alt="">
    <div class="title">ENHANCED COMBAT</div>
  </main>
  <aside id="controls">
    <label>Fond <input data-variable="--background-opacity" type="range" min="0" max="1" step="0.01" value="0.5"> <output>0.5</output></label>
    <label>Titre X <input data-variable="--title-x" data-unit="px" type="range" min="0" max="1672" step="1" value="535"> <output>535</output></label>
    <label>Titre Y <input data-variable="--title-y" data-unit="px" type="range" min="0" max="941" step="1" value="465"> <output>465</output></label>
    <button id="copy" type="button">Copier les valeurs pour le prompt</button>
  </aside>
  <script>
    const inputs = [...document.querySelectorAll('#controls input')];
    for (const input of inputs) input.addEventListener('input', () => { document.documentElement.style.setProperty(input.dataset.variable, input.value + (input.dataset.unit || '')); input.nextElementSibling.value = input.value; });
    document.querySelector('#copy').addEventListener('click', async () => { const values = inputs.map(input => `${input.dataset.variable}=${input.value}${input.dataset.unit || ''}`).join(', '); await navigator.clipboard.writeText(values); });
    if (new URLSearchParams(location.search).has('render')) document.documentElement.classList.add('render');
  </script>
</body>
</html>
